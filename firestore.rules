rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================================================
    // Helpers
    // ===========================================================
    function isAuthed() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isOperator() {
      return isAuthed() && request.auth.token.operator == true;
    }

    // ===========================================================
    // Companies — owned per ownerUid; anonymous documents
    // (ownerUid == null) are server-managed only. Clients never
    // read or write anonymous docs directly; the Next.js server
    // (Admin SDK, bypassing rules) handles Stage 0.
    // ===========================================================
    match /companies/{companyId} {
      function isOwner() {
        return isAuthed() && resource.data.ownerUid == uid();
      }

      allow read: if isOwner() || isOperator();
      allow create: if isAuthed() && request.resource.data.ownerUid == uid();
      allow update: if isOwner() &&
                    request.resource.data.ownerUid == uid();
      allow delete: if false;

      // -------------------------------------------------------
      // Claims: APPEND-ONLY. The only write allowed to an
      // existing claim is flipping `supersededBy` from null to a
      // claimId. Everything else is a new claim.
      // -------------------------------------------------------
      match /claims/{claimId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid;
        }
        function isCompanyOwner() {
          return isAuthed() && parentOwner() == uid();
        }

        allow read: if isCompanyOwner() || isOperator();
        allow create: if isCompanyOwner();
        // Only supersededBy may change, and only from null to a string.
        allow update: if isCompanyOwner() &&
                      resource.data.supersededBy == null &&
                      request.resource.data.supersededBy is string &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supersededBy']);
        allow delete: if false;
      }

      // -------------------------------------------------------
      // Corrections: APPEND-ONLY. No update, no delete.
      // -------------------------------------------------------
      match /corrections/{correctionId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid;
        }
        function isCompanyOwner() {
          return isAuthed() && parentOwner() == uid();
        }

        allow read: if isCompanyOwner() || isOperator();
        allow create: if isCompanyOwner();
        allow update, delete: if false;
      }

      // -------------------------------------------------------
      // Open questions: server-managed; clients read only.
      // -------------------------------------------------------
      match /openQuestions/{questionId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid;
        }
        function isCompanyOwner() {
          return isAuthed() && parentOwner() == uid();
        }
        allow read: if isCompanyOwner() || isOperator();
        allow write: if false;
      }

      // -------------------------------------------------------
      // POLE+O graph nodes — owner-only context the prospect
      // enriches manually. Writes go through API routes (server
      // verifies auth + ownership via Admin SDK). Clients can read
      // for their own company.
      // -------------------------------------------------------
      match /graphNodes/{nodeId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid;
        }
        function isCompanyOwner() {
          return isAuthed() && parentOwner() == uid();
        }
        allow read: if isCompanyOwner() || isOperator();
        allow write: if false;
      }

      // -------------------------------------------------------
      // Roles (Phase 4). The invitee describes their role; the
      // inviter (company owner) sees aggregate. NO inviter-only
      // view of substance that contradicts what the invitee saw
      // — enforced by exposing only the server-computed aggregate
      // through the API. Per-activity claims are readable ONLY by
      // the invitee themselves.
      // -------------------------------------------------------
      match /roles/{roleId} {
        function parentOwner() {
          return get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid;
        }
        function isCompanyOwner() {
          return isAuthed() && parentOwner() == uid();
        }
        function isInvitee() {
          return isAuthed() && resource.data.inviteeUid == uid();
        }
        // Inviter can read role metadata (title, status, invitee email)
        // — the role doc itself contains no substance. Invitee reads
        // their own role meta. The actual activity classifications and
        // career strategy live in /claims and are invitee-only.
        allow read: if isInvitee() || isCompanyOwner() || isOperator();
        allow write: if false; // server-managed via Admin SDK only

        match /claims/{claimId} {
          function inviteeUid() {
            return get(/databases/$(database)/documents/companies/$(companyId)/roles/$(roleId)).data.inviteeUid;
          }
          // INVITEE-ONLY READ. The inviter never gets a substance-
          // different view of these. The aggregate API is the only
          // legitimate way for the inviter to learn from these claims,
          // and it never exposes per-invitee substance.
          allow read: if isAuthed() && inviteeUid() == uid();
          allow write: if false;
        }
      }
    }

    // ===========================================================
    // Invite index — server-managed lookup table from opaque
    // invite token to {companyId, roleId}. Anyone with the token
    // can open the page; the server reads the index via Admin SDK.
    // Clients never read or write this directly.
    // ===========================================================
    match /inviteIndex/{token} {
      allow read, write: if false;
    }

    // ===========================================================
    // Funnel events — operator-only read. Clients never write
    // directly; the Next.js server writes via Admin SDK.
    // ===========================================================
    match /funnelEvents/{eventId} {
      allow read: if isOperator();
      allow write: if false;
    }

    // ===========================================================
    // Workshop leads — the operator's private sales CRM. Fully
    // server-managed: every read and write goes through the
    // operator-gated /api/leads routes (Admin SDK, bypassing
    // rules). Clients never touch this collection directly.
    // ===========================================================
    match /workshopLeads/{leadId} {
      allow read, write: if false;
    }

    // ===========================================================
    // Anything else: deny.
    // ===========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
